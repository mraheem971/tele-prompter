<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light Theme Variant -->
    <style name="Base.Theme.Teleprompter" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/electric_blue_primary</item>
        <item name="colorPrimaryVariant">@color/electric_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/electric_cyan</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/light_bg</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/light_text_primary</item>
        <item name="colorSurfaceVariant">@color/light_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/light_text_secondary</item>
        <item name="colorOutline">@color/light_border</item>
        <item name="android:statusBarColor">@color/light_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/light_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- Rounded Shape Appearance -->
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Teleprompter.MediumComponent</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Teleprompter.LargeComponent</item>
    </style>

    <style name="Theme.Teleprompter" parent="Base.Theme.Teleprompter" />

    <!-- Immersive Prompter Fullscreen Theme -->
    <style name="Theme.Teleprompter.Fullscreen" parent="Theme.Teleprompter">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:keepScreenOn">true</item>
        <item name="android:statusBarColor">@color/midnight_bg</item>
        <item name="android:navigationBarColor">@color/midnight_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Component Shapes -->
    <style name="ShapeAppearance.Teleprompter.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Teleprompter.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">18dp</item>
    </style>

    <style name="ShapeAppearance.Teleprompter.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Rounded Card Style -->
    <style name="Widget.Teleprompter.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/midnight_border</item>
        <item name="cardBackgroundColor">@color/midnight_surface_card</item>
    </style>

    <style name="Widget.Teleprompter.Card.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/midnight_border</item>
        <item name="cardBackgroundColor">@color/midnight_surface_card</item>
    </style>

    <!-- Electric Button Styles -->
    <style name="Widget.Teleprompter.Button.Electric" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/electric_blue</item>
        <item name="android:textColor">#001824</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="iconTint">#001824</item>
        <item name="rippleColor">@color/white</item>
    </style>

    <style name="Widget.Teleprompter.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/electric_blue</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/electric_blue</item>
        <item name="iconTint">@color/electric_blue</item>
        <item name="rippleColor">@color/electric_blue_glow</item>
    </style>

    <style name="Widget.Teleprompter.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/midnight_surface_elevated</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/electric_blue</item>
        <item name="strokeColor">@color/midnight_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Electric Record Button -->
    <style name="Widget.Teleprompter.Button.Record" parent="Widget.Material3.Button">
        <item name="cornerRadius">20dp</item>
        <item name="backgroundTint">@color/record_red</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="iconTint">@color/white</item>
        <item name="rippleColor">@color/white</item>
    </style>

    <!-- Bottom Sheet Dialog Style -->
    <style name="BottomSheetDialogTheme" parent="Theme.Design.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetModalStyle</item>
    </style>

    <style name="BottomSheetModalStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>