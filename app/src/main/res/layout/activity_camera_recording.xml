<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cameraRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- CameraX Fullscreen Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreviewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- Studio Top Control Bar -->
    <LinearLayout
        android:id="@+id/cameraTopBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Close / Exit -->
        <ImageButton
            android:id="@+id/btnCameraClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dialog_close"
            android:src="@drawable/ic_close"
            app:tint="@color/white" />

        <!-- Flip Front/Back Camera -->
        <ImageButton
            android:id="@+id/btnCameraFlip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/camera_flip"
            android:src="@drawable/ic_camera_switch"
            app:tint="@color/white" />

        <!-- Flash / Torch Toggle -->
        <ImageButton
            android:id="@+id/btnCameraTorch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/camera_torch"
            android:src="@drawable/ic_flash_on"
            app:tint="@color/white" />

        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="1dp" />

        <!-- Recording Indicator Badge & Timer -->
        <LinearLayout
            android:id="@+id/layoutRecordingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_recording_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivRecordingPulseDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/ic_record"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvRecordingTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Floating Teleprompter Overlay Card (Positioned near the camera lens) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPrompterOverlay"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="72dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/electric_blue"
        app:cardBackgroundColor="#B3090D16">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Overlay Prompter Scroll View -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/overlayScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:overScrollMode="never">

                <FrameLayout
                    android:id="@+id/overlayMirrorContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="110dp"
                        android:paddingBottom="220dp">

                        <TextView
                            android:id="@+id/tvOverlayContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:textColor="@color/prompter_text_white"
                            android:textSize="24sp"
                            android:lineSpacingMultiplier="1.3"
                            android:textStyle="bold"
                            tools:text="This is your overlay prompter. Read directly into the camera lens with confidence." />

                        <TextView
                            android:id="@+id/tvOverlayEnd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="40dp"
                            android:gravity="center"
                            android:text="@string/prompter_reading_complete"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Overlay Eye Focus Band -->
            <FrameLayout
                android:id="@+id/overlayGuideBand"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="100dp"
                android:background="@drawable/bg_guide_band"
                android:clickable="false"
                android:focusable="false" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Studio Bottom Controls Dock -->
    <LinearLayout
        android:id="@+id/cameraBottomDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B3000000"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Row 1: Speed, Opacity, Mirror Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Speed Slower (-) -->
            <ImageButton
                android:id="@+id/btnCameraSpeedDown"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_speed"
                app:tint="@color/electric_cyan" />

            <TextView
                android:id="@+id/tvCameraSpeedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3x"
                android:textColor="@color/electric_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />

            <!-- Speed Faster (+) -->
            <ImageButton
                android:id="@+id/btnCameraSpeedUp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_add"
                app:tint="@color/electric_cyan" />

            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="1dp" />

            <!-- Text Mirror Toggle -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCameraMirrorToggle"
                style="@style/Widget.Teleprompter.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Mirror"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="6dp"
                app:icon="@drawable/ic_flip_horizontal"
                app:iconSize="14dp" />

            <!-- Prompter Opacity Cycle Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCameraOpacity"
                style="@style/Widget.Teleprompter.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="75%"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_visibility"
                app:iconSize="14dp" />
        </LinearLayout>

        <!-- Row 2: Scroll Play/Pause, Big Record Button, Reset -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Rewind Scroll to Top -->
            <ImageButton
                android:id="@+id/btnCameraResetScroll"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_restart"
                app:tint="@color/white" />

            <View
                android:layout_width="24dp"
                android:layout_height="1dp" />

            <!-- MAIN BIG RECORD / STOP BUTTON -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabRecordVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/camera_start_record"
                    android:src="@drawable/ic_videocam"
                    app:backgroundTint="@color/record_red"
                    app:tint="@color/white"
                    app:elevation="8dp"
                    app:fabCustomSize="64dp" />
            </FrameLayout>

            <View
                android:layout_width="24dp"
                android:layout_height="1dp" />

            <!-- Play / Pause Prompter Scroll during recording -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabCameraPlayPauseText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/prompter_play"
                android:src="@drawable/ic_play"
                app:backgroundTint="@color/electric_blue"
                app:tint="#001824"
                app:elevation="4dp"
                app:fabSize="mini" />

        </LinearLayout>

    </LinearLayout>

    <!-- Animated Countdown Overlay (3, 2, 1, Action!) -->
    <FrameLayout
        android:id="@+id/cameraCountdownOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCameraCountdownNumber"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_countdown_circle"
            android:gravity="center"
            android:text="3"
            android:textColor="@color/electric_blue"
            android:textSize="64sp"
            android:textStyle="bold" />
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
